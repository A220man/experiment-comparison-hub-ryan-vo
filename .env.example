# ==============================================================================
# Experiment Comparison Hub - Environment Configuration Template
# ==============================================================================
# All credentials blank by default. Copy to .env and configure secrets as needed.

# Application Environment (development | production)
ENVIRONMENT=development
APP_NAME="Experiment Comparison Hub"
APP_VERSION=0.1.0

# Session Cookie Signing Secret (generate via: openssl rand -hex 32)
SECRET_KEY=

# Local Simulated Personas Mode (REFUSED in production)
DEMO_MODE=true

# Persistent SQLite Storage
DATABASE_URL=sqlite:///storage/experiments.db

# OpenID Connect / Keycloak Authentication Broker
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# Large Language Model Advisory Explanation Configuration
# Supported providers: openai-compatible, anthropic, gemini, ollama
LLM_PROVIDER=openai
LLM_MODEL=qwen3.8-27b
LLM_BASE_URL=https://llm.chris-vo.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30.0
